<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New training available</title>
  </head>
  <body style="margin:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#172033;">
    <div style="max-width:640px;margin:0 auto;padding:32px 16px;">
      <div style="background:#173b67;border-radius:16px 16px 0 0;padding:28px 32px;color:#ffffff;">
        <div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;opacity:.85;">Next Learn</div>
        <h1 style="margin:12px 0 0;font-size:28px;line-height:1.2;">New training is available</h1>
      </div>
      <div style="background:#ffffff;padding:32px;border-radius:0 0 16px 16px;box-shadow:0 8px 24px rgba(23,59,103,.08);">
        <p style="font-size:16px;line-height:1.6;margin-top:0;">A new learning challenge has been assigned to you.</p>
        <div style="background:#eef5ff;border-left:4px solid #2d72d9;padding:16px 18px;margin:24px 0;">
          <div style="font-size:12px;letter-spacing:1px;text-transform:uppercase;color:#52709a;">Course</div>
          <div style="font-size:22px;font-weight:700;margin-top:6px;"><%= title %></div>
        </div>
        <p style="font-size:15px;line-height:1.6;">Please complete this course by <strong><%= dueAt %></strong>.</p>
        <p style="margin:28px 0;">
          <a href="<%= link %>" style="display:inline-block;background:#2d72d9;color:#ffffff;text-decoration:none;border-radius:8px;padding:13px 22px;font-weight:700;">Open Next Learn</a>
        </p>
        <p style="font-size:13px;line-height:1.6;color:#6d7788;margin-bottom:0;">You can review the video, key learning points, and quiz from the Next Learn platform.</p>
      </div>
      <p style="font-size:12px;color:#8a93a2;text-align:center;margin:18px 0 0;">This is an automated training notification.</p>
    </div>
  </body>
</html>
